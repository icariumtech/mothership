# =============================================================================
# JANUS — Sci-Fi Campaign Console
# Copy this file to .env and configure your settings
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Compose (required if running via docker compose from the project root)
# -----------------------------------------------------------------------------
COMPOSE_FILE=docker/compose.yml

# -----------------------------------------------------------------------------
# JANUS AI Integration (Required for AI features)
# -----------------------------------------------------------------------------
# Your Anthropic API key for Claude integration
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# -----------------------------------------------------------------------------
# Network (homelab/container deployments)
# -----------------------------------------------------------------------------
# Required when accessing via IP:port or custom domain — prevents CSRF errors.
# Comma-separated full origins: http://192.168.1.100:8000,https://janus.example.com
CSRF_TRUSTED_ORIGINS=
